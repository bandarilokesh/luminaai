# ---------- LLM: "groq" or "gemini" ----------
LLM_PROVIDER=groq
# Free key: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
TEMPERATURE=0.2
MAX_TOKENS=2048

# ---------- Embeddings (Jina AI) ----------
# Free key: https://jina.ai/embeddings
JINA_API_KEY=
EMBEDDING_MODEL=jina-embeddings-v3
# Must match the Qdrant collection's vector size. Changing it requires a new QDRANT_COLLECTION.
EMBEDDING_DIM=1024

# ---------- Vector database (Qdrant) ----------
# Local Docker: docker compose up -d qdrant   (dashboard: http://localhost:6333/dashboard)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=lumina_papers

# ---------- Chunking & retrieval ----------
CHUNK_SIZE=400
CHUNK_OVERLAP=60
TOP_K=5
# Ignore chunks with cosine similarity below this (0 = keep all top-k)
SCORE_THRESHOLD=0.0
# Max tokens of retrieved context sent to the LLM (keep modest for free-tier rate limits)
CONTEXT_TOKEN_BUDGET=6000

# ---------- Observability (Langfuse Cloud, free Hobby tier) ----------
# Keys: https://cloud.langfuse.com -> project -> Settings -> API Keys. Blank = tracing off.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# EU: https://cloud.langfuse.com   US: https://us.cloud.langfuse.com
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# ---------- App ----------
# Optional shared password for the whole app. Blank = open.
ACCESS_CODE=
MAX_UPLOAD_SIZE_MB=50
