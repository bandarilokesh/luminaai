# General Settings
DEBUG=False
APP_NAME="Lumina Ai"

# Model Configurations
# Choose from: BAAI/bge-small-en-v1.5, BAAI/bge-base-en-v1.5, sentence-transformers/all-MiniLM-L6-v2, intfloat/e5-small-v2, intfloat/e5-base-v2
DEFAULT_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Re-ranking Configurations
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
USE_RERANKER=True

# Database & Vector DB Settings
# Choices: faiss, chroma
DEFAULT_VECTOR_DB=faiss

# RAG Chunker settings
CHUNK_SIZE=700
CHUNK_OVERLAP=100

# Retrieval settings
TOP_K_DENSE=5
TOP_K_SPARSE=5
HYBRID_ALPHA=0.5
RERANK_TOP_N=3

# Gemini API configuration
GEMINI_API_KEY=<your_api_key>
LLM_PROVIDER=gemini
MODEL_NAME=gemini-flash-lite-latest
TEMPERATURE=0.2
MAX_TOKENS=1024
